<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:openDrawer="start">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <include
            android:id="@+id/bar"
            layout="@layout/back_bar"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_home"
            style="@style/main_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="8dp"
            android:text="- 식단 기록 -"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bar" />

        <TextView
            android:id="@+id/mealTimetv"
            style="@style/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="식사시간"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/text_home" />

        <Button
            android:id="@+id/mealTimebtn"
            style="@style/btn_text"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/main"
            android:text="선택"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/mealTimetv" />

        <TextView
            android:id="@+id/pictureTv"
            style="@style/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginRight="24dp"
            android:text="식사사진"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/mealTimebtn" />

        <Button
            android:id="@+id/pictureBtn"
            style="@style/btn_text"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/main"
            android:text="업로드"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/pictureTv" />
        <ImageView
            android:id="@+id/menuImg"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="25dp"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/mealTimebtn"/>

        <TextView
            android:id="@+id/sortTv"
            style="@style/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="유형"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/pictureBtn" />

        <TextView
            android:id="@+id/sortExplain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="※새벽에 드신 야식은 전일 기록에 합산됩니다."
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/sortTv" />

        <Spinner
            android:id="@+id/sortSp"
            style="@style/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="28dp"
            android:entries="@array/meal_what"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@+id/sortExplain" />

        <TextView
            android:id="@+id/menutv"
            style="@style/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="메뉴"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/sortSp" />

        <EditText
            android:id="@+id/menuEdit"
            android:layout_width="300dp"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:hint=" ex) 제육볶음, 한정식"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/menutv" />

        <TextView
            android:id="@+id/caltv"
            style="@style/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="칼로리(kcal)"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/menuEdit" />

        <EditText
            android:id="@+id/calEdit"
            android:layout_width="300dp"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:hint=" ex) 식사의 열량을 kcal단위로 입력"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/caltv" />

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="340dp"
            android:layout_height="55dp"
            android:layout_marginBottom="60dp"
            android:text="저장"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="46dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="365dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nDrawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:fitsSystemWindows="true"
        android:background="@color/background"
        app:menu="@menu/menu" />
</androidx.drawerlayout.widget.DrawerLayout>