<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:openDrawer="start">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/bar"
            layout="@layout/back_bar"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_home"
            style="@style/main_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="8dp"
            android:text="- 변화 기록 -"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bar" />

        <TextView
            android:id="@+id/pic_tv"
            style="@style/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="눈바디"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/text_home" />

        <Button
            android:id="@+id/pic_btn"
            style="@style/btn_text"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:background="@color/main"
            android:text="업로드"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/pic_tv" />

        <ImageView
            android:id="@+id/bodyImg"
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/pic_tv"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/weight_tv"
            style="@style/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:text="체중"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/pic_btn" />

        <EditText
            android:id="@+id/weight_edit"
            android:layout_width="300dp"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:hint=" 단위는 kg"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/weight_tv" />

        <TextView
            android:id="@+id/waist_tv"
            style="@style/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="허리 둘레"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/weight_edit" />

        <EditText
            android:id="@+id/waist_edit"
            android:layout_width="300dp"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:hint=" 단위는 cm"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/waist_tv" />

        <TextView
            android:id="@+id/thigh_tv"
            style="@style/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="허벅지 둘레"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/waist_edit" />

        <EditText
            android:id="@+id/thigh_edit"
            android:layout_width="300dp"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:hint=" 단위는 cm"
            app:layout_constraintLeft_toLeftOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/thigh_tv" />

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="340dp"
            android:layout_height="55dp"
            android:layout_marginBottom="60dp"
            android:text="저장"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="46dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.navigation.NavigationView
    android:id="@+id/nDrawer"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:fitsSystemWindows="true"
    android:background="@color/background"
    app:menu="@menu/menu" />
</androidx.drawerlayout.widget.DrawerLayout>